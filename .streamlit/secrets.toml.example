# ALERT_SMTP_PORT = 587
# ALERT_SMTP_USER = "you@gmail.com"
# ALERT_SMTP_PASSWORD = "<a Gmail App Password, NOT your real account password>"
# ALERT_EMAIL_TO = "you@gmail.com"

