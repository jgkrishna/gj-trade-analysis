# Copy this file to secrets.toml (same folder) and set a real password HASH.
# secrets.toml is gitignored -- it will never be committed or pushed.
# This .example file IS committed, so never put a real password (plaintext
# OR hash of a password you still use elsewhere) in this specific file.
#
# Generate the hash by running, from this project's folder:
#     python hash_password.py
# It prompts for a password locally and prints a line to paste below.
# Only the hash is ever stored -- the plaintext password is never written
# to disk or committed anywhere.

password_hash = "scrypt$<paste the value python hash_password.py prints here>"

# --- Alerts (all optional -- omit any/all of these to leave that channel off) ---
# Same rule applies: real values go in secrets.toml, never in this .example file.

